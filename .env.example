# Browser requests use the Vite/Vercel same-origin proxy by default.
VITE_API_BASE_URL=/api/v1

# Used only by the local Vite development server.
VITE_API_PROXY_TARGET=http://3.34.62.133

# Readable CSRF cookies issued by the backend after login.
VITE_USER_CSRF_COOKIE_NAME=arena_csrf
VITE_ADMIN_CSRF_COOKIE_NAME=arena_admin_csrf
